{
  "name": "chocolat-backoffice-electron",
  "version": "1.0.0",
  "description": "Chocolat Backoffice - SQLite + Electron",
  "author": {
    "name": "Chocolat Backoffice Team",
    "email": "contact@chocolat-backoffice.local"
  },
  "homepage": "https://chocolat-backoffice.local",
  "desktopName": "chocolat-backoffice.desktop",
  "main": "electron/main.js",
  "scripts": {
    "web": "node web/server.cjs",
    "web:build": "npm run build:frontend && node web/server.cjs",
    "start": "node scripts/start-electron.cjs",
    "dev": "node scripts/start-electron.cjs",
    "build:frontend": "npm --prefix frontend install --include=dev && npm --prefix frontend run build",
    "build:electron": "npm run build:frontend && electron-builder --win nsis portable",
    "build:windows": "npm run build:frontend && electron-builder --win nsis portable",
    "build:linux": "npm run build:frontend && electron-builder --linux AppImage deb tar.xz",
    "build:signed": "npm run build:frontend && set CSC_LINK=%CSC_LINK% && set CSC_KEY_PASSWORD=%CSC_KEY_PASSWORD% && electron-builder --win nsis portable",
    "sign:test-cert": "powershell -File scripts/generate-test-cert.ps1",
    "backend": "node backend-sqlite/server.cjs",
    "onedrive:login": "node backend-sqlite/onedriveLogin.cjs",
    "sync:start": "node backend-sqlite/sync-server.cjs",
    "build:linux:rpm": "npm run build:frontend && electron-builder --linux rpm",
    "test": "node --test backend-sqlite/server.test.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-is-dev": "^2.0.0",
    "exceljs": "^3.4.0",
    "express": "^5.0.0",
    "google-auth-library": "^11.1.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.5.0"
  },
  "build": {
    "appId": "com.chocolat.backoffice",
    "productName": "Chocolat Backoffice (SQLite + Electron)",
    "directories": {
      "output": "dist2"
    },
    "files": [
      "electron/**/*",
      "backend-sqlite/**/*",
      "frontend/dist/**/*",
      "package.json",
      "!**/*.test.cjs"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/chocologo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.xz"
      ],
      "icon": "electron/chocologo.png",
      "category": "Office",
      "maintainer": "Chocolat Backoffice Team <contact@chocolat-backoffice.local>",
      "vendor": "Chocolat Backoffice",
      "executableName": "chocolat-backoffice",
      "artifactName": "chocolat-backoffice-${version}-${arch}.${ext}",
      "syncDesktopName": true
    }
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron-winstaller": false
  }
}
